# MADA God's Eye — Environment Variables
CESIUM_ION_TOKEN=your_free_cesium_token
CZML_PORT=3001
GFW_API_KEY=your_global_fishing_watch_key
SPIDERFOOT_URL=http://localhost:5001

# CogniMesh Local Models
QWEN35_UNCENSORED_PATH=/opt/models/qwen35-uncensored.gguf
DOLPHIN_UNCENSORED_PATH=/opt/models/dolphin-2.9.3-llama3-8b.gguf
MYTHOMAX_UNCENSORED_PATH=/opt/models/mythomax-l2-13b.gguf
PYGMALION_UNCENSORED_PATH=/opt/models/pygmalion-2-13b.gguf
LLAMA31_UNCENSORED_PATH=/opt/models/llama-3.1-8b-instruct.gguf
DEEPSEEK_MOE_PATH=/opt/models/deepseek-r1-distill-qwen-14b.gguf
KIMI_K25_PATH=/opt/models/kimi-k2.5-distill-qwen-14b.gguf

# API Keys (for cloud fallback when CogniMesh offline not available)
DEEPSEEK_API_KEY=sk-xxx
GROK_API_KEY=xai-xxx
KIMI_K2_5_API_KEY=sk-xxx

# Sovereignty
Q_ENC_5D_ENABLED=true
BLOCKCHAIN_LEDGER=true
COGNIMESH_OFFLINE=true
